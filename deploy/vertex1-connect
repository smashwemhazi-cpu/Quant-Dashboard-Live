#!/usr/bin/env bash
# Guided setup for D.O.N.N.A's personal side: private Discord channel, work inbox, Google Calendar.
# Run as root on the server:  vertex1-connect      (press Enter to skip any question; secrets are not shown)
set -euo pipefail
ENV=/etc/vertex1/vertex1.env
PY=/opt/vertex1/venv/bin/python
[ "$(id -u)" = 0 ] || { echo "Run as root."; exit 1; }
cp -p "$ENV" "$ENV.bak.$(date +%Y%m%d-%H%M%S)"

ask() {  # ask NAME "question" hidden(0/1)
  local v
  if [ "$3" = 1 ]; then read -rsp "$2: " v; echo; else read -rp "$2: " v; fi
  v="$(printf '%s' "$v" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  if [ -n "$v" ]; then export "SET_$1=$v"; fi
}

echo "Press Enter to skip any question. Hidden answers show nothing while you paste - that is normal."
ask DONNA_DISCORD_WEBHOOK_PERSONAL "1/5 Private Discord channel webhook URL (hidden)" 1
ask JARVIS_IMAP_USER "2/5 Work email address" 0
ask JARVIS_IMAP_PASSWORD "3/5 Google app password - 16 letters (hidden)" 1
ask JARVIS_GCAL_ICS_URL "4/5 Google Calendar secret address in iCal format (hidden)" 1
ask JARVIS_PERSONAL_ACCOUNT "5/5 Your personal cTrader account number" 0

"$PY" - "$ENV" <<'EOF'
import os, re, sys

path = sys.argv[1]
lines = open(path).read().splitlines()
new = {k[4:]: v for k, v in os.environ.items() if k.startswith("SET_")}
if "JARVIS_IMAP_PASSWORD" in new:
    new["JARVIS_IMAP_PASSWORD"] = new["JARVIS_IMAP_PASSWORD"].replace(" ", "")  # Google shows it in groups of 4
for k, v in list(new.items()):
    if re.search(r'["`$\\]', v):
        print(f"SKIPPED {k}: contains a quote, backtick, $ or backslash - paste it again without those")
        new.pop(k)
present = {l.split("=", 1)[0] for l in lines if "=" in l and not l.lstrip().startswith("#")}
for k, v in {"JARVIS_IMAP_HOST": "imap.gmail.com", "JARVIS_LOCAL_TZ": "Etc/GMT-4", "JARVIS_CTRADER_UTC_OFFSET": "4",
             "JARVIS_PERSONAL_TARGETS": "discord:personal", "JARVIS_INBOX_DIR": "/var/lib/vertex1/inbox"}.items():
    if k not in present:
        new.setdefault(k, v)
fmt = lambda v: f'"{v}"' if re.search(r"[^A-Za-z0-9_@./:%+=,-]", v) else v  # noqa: E731
out, done = [], set()
for l in lines:
    k = l.split("=", 1)[0]
    if k in new and not l.lstrip().startswith("#"):
        out.append(f"{k}={fmt(new[k])}")
        done.add(k)
    else:
        out.append(l)
out += [f"{k}={fmt(v)}" for k, v in new.items() if k not in done]
open(path, "w").write("\n".join(out) + "\n")
print("Saved:", ", ".join(sorted(new)) or "nothing changed")
EOF

systemctl restart vertex1-scheduler
echo
echo "Checking connections..."
sudo -u vertex1 bash -c 'set -a; . /etc/vertex1/vertex1.env; cd /opt/vertex1/app; /opt/vertex1/venv/bin/python -c "
import imaplib, os
from jarvis.agents import assistant as a
u, p = os.getenv(\"JARVIS_IMAP_USER\"), os.getenv(\"JARVIS_IMAP_PASSWORD\")
if u and p:
    try:
        with imaplib.IMAP4_SSL(os.getenv(\"JARVIS_IMAP_HOST\", \"imap.gmail.com\")) as m:
            m.login(u, p); print(\"EMAIL     OK - read-only access works\")
    except Exception as e:
        print(\"EMAIL     FAILED -\", str(e)[:150])
else:
    print(\"EMAIL     not set\")
c = a.calendar_events(days=7)
print(\"CALENDAR \", (\"FAILED - \" + c[\"error\"]) if \"error\" in c else (\"OK - %d events in the next 7 days\" % len(c[\"events\"])))
print(\"API KEY  \", \"set\" if os.getenv(\"ANTHROPIC_API_KEY\") else \"MISSING - email analysis needs it\")
r = a.AssistantAgent().my_day(send=True).get(\"delivery\")
print(\"DISCORD  \", r)
"'
echo
echo "Done. Your my-day brief should now be in the private Discord channel."
