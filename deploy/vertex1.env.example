# /etc/vertex1/vertex1.env - no comments after values (systemd keeps them). Owner root:vertex1, chmod 640. NEVER commit the filled-in copy.
# Generate random values with:  openssl rand -hex 32

# ---- paths (created by install.sh) ----
DONNA_DB_PATH=/var/lib/vertex1/donna.db
DONNA_FILES_DIR=/var/lib/vertex1/generated
JARVIS_STATE_DB=/var/lib/vertex1/jarvis_state.db
JARVIS_DATA_DIR=/var/lib/vertex1/data
JARVIS_TV_EXPORT_DIR=/var/lib/vertex1/tradingview
JARVIS_INBOX_DIR=/var/lib/vertex1/inbox
# 0 = never generate synthetic data on the server
JARVIS_DEMO=0
TG_SESSION=/var/lib/vertex1/donna_lead_monitor

# ---- AI ----
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5

# ---- DONNA auth ----
DONNA_URL=http://127.0.0.1:8080
DONNA_API_KEY=
DONNA_APPROVER_KEYS=simba:CHANGE_ME
DONNA_TV_PASSPHRASE=

# ---- Telegram bot (approvals + reports) ----
DONNA_TELEGRAM_BOT_TOKEN=
DONNA_TELEGRAM_CHAT_ID=
DONNA_TELEGRAM_WEBHOOK_SECRET=
DONNA_TELEGRAM_APPROVER_IDS=

# ---- Telegram user session (lead monitor) - from https://my.telegram.org ----
TG_API_ID=
TG_API_HASH=
LEAD_GROUPS=

# ---- Discord ----
DONNA_DISCORD_WEBHOOK_REPORTS=
DONNA_DISCORD_WEBHOOK_SIGNALS=
# private channel for the my-day brief, urgent emails and personal trading
DONNA_DISCORD_WEBHOOK_PERSONAL=
# separate bot app "DONNA Tasks" for !tasks / !done (Message Content intent on); answers only in these channels
DONNA_DISCORD_BOT_TOKEN=
DONNA_DISCORD_COMMAND_CHANNELS=track-b-personal
DONNA_DISCORD_ALLOWED_USERS=

# ---- personal assistant (set with: vertex1-connect) ----
# Google Workspace mailbox, read-only IMAP with a Google app password
JARVIS_IMAP_HOST=imap.gmail.com
JARVIS_IMAP_USER=
JARVIS_IMAP_PASSWORD=
# Google Calendar > Settings > your calendar > Integrate calendar > Secret address in iCal format
JARVIS_GCAL_ICS_URL=
# IANA zone for calendar/my-day times; Etc/GMT-4 means UTC+4
JARVIS_LOCAL_TZ=Etc/GMT-4
# hours ahead of UTC that cTrader shows statement times in
JARVIS_CTRADER_UTC_OFFSET=4
JARVIS_PERSONAL_ACCOUNT=
JARVIS_MYDAY_UTC_HOUR=4
# daily wrap hour (UTC); 22 = after the NY close, earlier hours show US markets mid-session
JARVIS_WRAP_UTC_HOUR=22

# ---- Slack / Teams / Email (leave blank if unused) ----
DONNA_SLACK_BOT_TOKEN=
DONNA_TEAMS_WEBHOOK_URL=
DONNA_SMTP_HOST=smtp.gmail.com
DONNA_SMTP_PORT=465
DONNA_SMTP_USER=
DONNA_SMTP_PASSWORD=

# ---- routing ----
JARVIS_REPORT_TARGETS=discord:reports
JARVIS_PERSONAL_TARGETS=discord:personal
DONNA_SIGNAL_TARGETS=discord:signals
DONNA_DEMO_DEPLOY_DIR=
DONNA_REP_NAME="the Vertex 1 desk"
DONNA_FIRM_DISCLOSURE="Vertex 1 Brokers (FSP <number>)"
