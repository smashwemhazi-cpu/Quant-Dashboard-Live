[Unit]
Description=D.O.N.N.A Discord task commands (!tasks !done !add !today)
After=network-online.target
Wants=network-online.target

[Service]
User=vertex1
Group=vertex1
WorkingDirectory=/opt/vertex1/app
EnvironmentFile=/etc/vertex1/vertex1.env
ExecStart=/opt/vertex1/venv/bin/python -m donna.discord_bot
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vertex1

[Install]
WantedBy=multi-user.target
